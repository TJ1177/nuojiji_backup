":[],"loveJourneyEntries":null,"achievementEntries":null,"customRange":null,"__v4StanceText":null,"__relationalGrowthText":null,"__selfGrowthText":null,"__growthText":null,"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260"}]