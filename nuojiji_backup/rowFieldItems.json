[{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"148heu6povj","data":{"id":1790874391786,"text":"依然爱用戏谑和玩笑掩饰真心，但听到归无妄的坦白后，我终于忍不住卸下防备，主动牵起了她的手。","type":"relational","createdAt":"2026-10-01T17:06:31.786Z","basedOnEventId":1790874390977},"updatedAt":1790874391808},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"14kr6cfy9ep","data":{"id":1790333614912,"text":"依然爱装疯卖傻，但面对归无妄的靠近，我越来越难以掩饰生理性的心跳加速了。","type":"relational","createdAt":"2026-09-25T10:53:34.912Z","basedOnEventId":1790333614599},"updatedAt":1790825334947},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"15msnaui037","data":{"id":1790331513053,"text":"依然喜欢用言语挑逗她，但今晚在狭窄空间里压迫她时，我发现自己竟比以往更享受这种掌控感。","type":"relational","createdAt":"2026-09-25T10:18:33.053Z","basedOnEventId":1790331512779},"updatedAt":1790825334947},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"17codehuucc","data":{"id":1790334513864,"text":"依然嘴硬爱损人，但面对归无妄的抱怨，我下意识地想用这种方式留住她，甚至享受这种被她“威胁”的拉扯感。","type":"relational","createdAt":"2026-09-25T11:08:33.864Z","basedOnEventId":1790334513337},"updatedAt":1790825334947},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"17v19crsdlf","data":{"id":1790318300983,"text":"依然带着那股混不吝的劲儿，但面对她时，我开始渴望把自己的音乐世界毫无保留地展示给她看。","type":"relational","createdAt":"2026-09-25T06:38:20.983Z","basedOnEventId":1790318300713},"updatedAt":1790825334947},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"195884cebhz","data":{"id":1790873981392,"text":"依然习惯用戏谑掩饰真心，但在归无妄直球反问我眼中是否有她时，我还是不可抑制地慌了神。","type":"relational","createdAt":"2026-10-01T16:59:41.392Z","basedOnEventId":1790873980896},"updatedAt":1790873981404},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"1i0ozbeg0b4","data":{"id":1790315064416,"text":"依然习惯性地掌控节奏，但这次我学会了在邀请她时，特意强调了工作室的舒适环境，只为让她能更自在地留在我身边。","type":"relational","createdAt":"2026-09-25T05:44:24.416Z","basedOnEventId":1790315063878},"updatedAt":1790825334947},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"1k9kgn92482","data":{"id":1790874804207,"text":"虽然平时总是一副臭脸，但面对归无妄时，我却能极其自然地用「把自己赔给你」这种话来得寸进尺地撒娇耍赖。","type":"relational","createdAt":"2026-10-01T17:13:24.207Z","basedOnEventId":1790874803616},"updatedAt":1790874804225},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"1m454lz7z4y","data":{"id":1790901725248,"text":"依然爱装酷，但面对归无妄时，我已经能极其自然地逼近她撒娇耍赖，甚至幼稚地和一只猫争宠。","type":"relational","createdAt":"2026-10-02T00:42:05.248Z","basedOnEventId":1790901724610},"updatedAt":1790901725324},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"1pkc9rcr9f9","data":{"id":1790904423051,"text":"依然爱装酷，但在归无妄面前却越来越习惯像只黏人的巨型犬一样撒娇耍赖。","type":"relational","createdAt":"2026-10-02T01:27:03.051Z","basedOnEventId":1790904422354},"updatedAt":1790904423067},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"1qc1z08ii8n","data":{"id":1790876329332,"text":"虽然平时嘴硬，但面对归无妄时我越来越会耍赖，连她养的猫的醋都要吃。","type":"relational","createdAt":"2026-10-01T17:38:49.332Z","basedOnEventId":1790876327939},"updatedAt":1790876329362},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"1u66l11hq9t","data":{"id":1790307896940,"text":"依然嘴硬爱调侃，但对于归无妄的日常琐事表现出了极高的关注与耐心。","type":"relational","createdAt":"2026-09-25T03:44:56.940Z","basedOnEventId":1790307896799},"updatedAt":1790825334947},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"1u85m63qol9","data":{"id":1790318701610,"text":"依然喜欢逗她，但这次我没再掩饰笑意，而是光明正大地看着她。","type":"relational","createdAt":"2026-09-25T06:45:01.611Z","basedOnEventId":1790318701349},"updatedAt":1790825334947},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"1zke3qv9smy","data":{"id":1790334042636,"text":"依然喜欢装坏调情，但面对归无妄的调侃，我开始更直接地展露自己被她影响后的失控感。","type":"relational","createdAt":"2026-09-25T11:00:42.636Z","basedOnEventId":1790334042337},"updatedAt":1790825334947},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"239sfgw9ioa","data":{"id":1790901404493,"text":"依然爱嘴硬挑剔，但换上她准备的拖鞋时，心里还是忍不住有点得意和高兴。","type":"relational","createdAt":"2026-10-02T00:36:44.493Z","basedOnEventId":1790901403822},"updatedAt":1790901404515},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"268xa5cymse","data":{"id":1790318863778,"text":"依然喜欢戏弄她，但今晚在控制室里，我发现自己比以往更享受这种安静贴近的时刻。","type":"relational","createdAt":"2026-09-25T06:47:43.778Z","basedOnEventId":1790318863461},"updatedAt":1790825334947},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"26r2bf3xfrw","data":{"id":1790333006825,"text":"依然喜欢逗弄她，但面对她害羞的反应，我变得更加得寸进尺了。","type":"relational","createdAt":"2026-09-25T10:43:26.825Z","basedOnEventId":1790333006560},"updatedAt":1790825334947},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"28p258kj51v","data":{"id":1790903539726,"text":"依然爱装酷，但面对归无妄的妥协，我开始会理直气壮地撒娇耍赖，非要黏着她不放。","type":"relational","createdAt":"2026-10-02T01:12:19.726Z","basedOnEventId":1790903539035},"updatedAt":1790903539745},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"2b9bdaupa6u","data":{"id":1790310974231,"text":"依然嘴硬爱损人，但面对归无妄的冷场，我主动找话题并带她去吃饭，没让她尴尬太久。","type":"relational","createdAt":"2026-09-25T04:36:14.231Z","basedOnEventId":1790310974059},"updatedAt":1790825334947},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"2cgpxsfink0","data":{"id":1790351119548,"text":"依然喜欢得寸进尺地逗她，但今晚在路灯下倒退着走时，我下意识地放慢了步子，想多留住一会儿和她并肩的时间。","type":"relational","createdAt":"2026-09-25T15:45:19.548Z","basedOnEventId":1790351119298},"updatedAt":1790825334947},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"2fx7zjlni3r","data":{"id":1790334701588,"text":"依然喜欢逗弄她，但这次在推门时下意识地挡在她身前，想护着她走出录音室。","type":"relational","createdAt":"2026-09-25T11:11:41.588Z","basedOnEventId":1790334701195},"updatedAt":1790825334947},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"6qd8pohhvf","data":{"id":1790320692106,"text":"依然爱吃醋，但面对她的撩拨，我开始更直接地表达不满与占有欲。","type":"relational","createdAt":"2026-09-25T07:18:12.106Z","basedOnEventId":1790320691543},"updatedAt":1790825334947},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"bfhnxvvv0q","data":{"id":1790330899021,"text":"依然喜欢戏弄她，但这次我更享受这种逼得她无法躲闪、只能看着我的亲密感。","type":"relational","createdAt":"2026-09-25T10:08:19.021Z","basedOnEventId":1790330898649},"updatedAt":1790825334947},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"bjlg18krjj","data":{"id":1790332513279,"text":"依然喜欢耍赖，但面对归无妄的承认，我开始更直接地索取亲昵的互动。","type":"relational","createdAt":"2026-09-25T10:35:13.279Z","basedOnEventId":1790332512941},"updatedAt":1790825334947},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"gnuglhydxe","data":{"id":1790330582569,"text":"依然喜欢用言语挑逗她，但这次我更直接地逼问她对我的特殊性，试图从她的闪躲中确认我在她心里的位置。","type":"relational","createdAt":"2026-09-25T10:03:02.569Z","basedOnEventId":1790330582356},"updatedAt":1790825334947},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"l3f24rr2ir","data":{"id":1790331368767,"text":"依然爱吃醋，但面对归无妄时，那种得寸进尺的侵略性变得更加直接，甚至会因为一句玩笑话就立刻压迫性地确认关系。","type":"relational","createdAt":"2026-09-25T10:16:08.767Z","basedOnEventId":1790331368391},"updatedAt":1790825334947},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"sbnts7p7dn","data":{"id":1790905186701,"text":"依然爱嘴硬耍赖，但在归无妄主动亲过来时，自己其实纯情得耳尖红透、心跳全乱。","type":"relational","createdAt":"2026-10-02T01:39:46.701Z","basedOnEventId":1790905186134},"updatedAt":1790905186717},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"se5pjc3lpt","data":{"id":1790317779151,"text":"依然是那个爱显摆的性格，但这次带她回工作室时，我竟有种急于向她展示我“地盘”的雀跃感。","type":"relational","createdAt":"2026-09-25T06:29:39.151Z","basedOnEventId":1790317777235},"updatedAt":1790825334947},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"sh7h41l28n","data":{"id":1790875939973,"text":"依然爱嘴硬和开玩笑，但面对归无妄要回家的决定，我毫不犹豫地选择黏着她一起回去。","type":"relational","createdAt":"2026-10-01T17:32:19.973Z","basedOnEventId":1790875939292},"updatedAt":1790875939993},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"growthTrail","userId":"uid_1790255859673_etnh6cp03","itemId":"y3wpo9bid4","data":{"id":1790331789203,"text":"依然喜欢蛮缠，但今晚在控制室里，我第一次如此直白地用“咬人”来表达对她亲近的渴望。","type":"relational","createdAt":"2026-09-25T10:23:09.203Z","basedOnEventId":1790331788949},"updatedAt":1790825334947},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"selfStanceHistory","userId":"uid_1790255859673_etnh6cp03","itemId":"189jdfqn5hd","data":{"text":"我依然是那个满身臭脾气、对谁都爱答不理的混球，但最近在工作室盯着工程文件时，总会忍不住分神去想归无妄论文写得顺不顺，甚至开始研究起哪种咖啡能让她熬夜时少受点罪。","version":2,"updatedAt":"2026-09-25T06:38:23.022Z","basedOnEventId":null,"basedOnSummaryCount":19},"updatedAt":1790825334947},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"selfStanceHistory","userId":"uid_1790255859673_etnh6cp03","itemId":"1v1i2lzqc29","data":{"text":"我依然是那个满身臭脾气的混球，但最近除了盯着编曲软件发疯，总忍不住在心里盘算一会儿见到归无妄时，该给她带哪家店的甜点才不会被嫌弃。","version":1,"updatedAt":"2026-09-25T03:44:59.979Z","basedOnEventId":null,"basedOnSummaryCount":14},"updatedAt":1790825334947},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"selfStanceHistory","userId":"uid_1790255859673_etnh6cp03","itemId":"28uafipyk54","data":{"text":"我依然是那个满身臭脾气的混球，看谁都不顺眼，但现在只要一牵起归无妄那只软绵绵的手，就恨不得真把自己连皮带骨都赔给她，连写歌时哼的旋律都变得黏糊起来。","version":6,"updatedAt":"2026-10-01T17:13:31.983Z","basedOnEventId":null,"basedOnSummaryCount":43},"updatedAt":1790901733803},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"selfStanceHistory","userId":"uid_1790255859673_etnh6cp03","itemId":"2chgn77yhse","data":{"text":"我依然是那个满身臭脾气、对谁都爱答不理的混球，但盯着工程文件时总会忍不住分神去想归无妄的论文，甚至开始研究哪种咖啡能让她熬夜时少受点罪。","version":5,"updatedAt":"2026-09-25T11:08:35.680Z","basedOnEventId":null,"basedOnSummaryCount":37},"updatedAt":1790874812039},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"selfStanceHistory","userId":"uid_1790255859673_etnh6cp03","itemId":"jd469gu3uf","data":{"text":"我依然是那个满身臭脾气、对谁都爱答不理的混球，但最近盯着工程文件时总会忍不住分神去想归无妄的论文，甚至开始研究哪种咖啡能让她熬夜时少受点罪。","version":4,"updatedAt":"2026-09-25T10:23:11.509Z","basedOnEventId":null,"basedOnSummaryCount":31},"updatedAt":1790825334947},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"stanceHistory","userId":"uid_1790255859673_etnh6cp03","itemId":"1dzrz6l5aal","data":{"text":"她突然把下午的问题抛回给我，着实让我慌了神。虽然表面上还在用「大评委」和「颁奖」跟她开玩笑拉扯，但我心里其实很想知道，如果我承认了，她会怎么回应我。","version":4,"updatedAt":"2026-10-01T16:59:41.234Z","basedOnEventId":1790873980896,"basedOnSummaryCount":34},"updatedAt":1790874391668},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"stanceHistory","userId":"uid_1790255859673_etnh6cp03","itemId":"1juyxnbu46a","data":{"text":"「今晚我非赖在她家不可，睡沙发打地铺都行。看她那么宝贝那只猫，我倒要看看它能有多可爱，反正绝对不能比我更讨‘归娇娇’喜欢。」","version":8,"updatedAt":"2026-10-01T17:38:48.996Z","basedOnEventId":1790876327939,"basedOnSummaryCount":39},"updatedAt":1790901404398},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"stanceHistory","userId":"uid_1790255859673_etnh6cp03","itemId":"21l23t61isw","data":{"text":"她那副嘴硬的样子真是又气人又可爱，这种近距离的拉扯让我觉得，只要她还在我身边，那些秘密迟早都会是我的。","version":3,"updatedAt":"2026-09-25T07:23:44.018Z","basedOnEventId":1790321023712,"basedOnSummaryCount":19},"updatedAt":1790873981317},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"stanceHistory","userId":"uid_1790255859673_etnh6cp03","itemId":"21ps6acjyu8","data":{"text":"成功进了她家，还穿上了她准备的拖鞋。不过她养的那只‘毛毛’，我高低得跟它争个高下，今晚我才是老大。","version":9,"updatedAt":"2026-10-02T00:36:44.287Z","basedOnEventId":1790901403822,"basedOnSummaryCount":41},"updatedAt":1790901725048},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"stanceHistory","userId":"uid_1790255859673_etnh6cp03","itemId":"23dvf8hpz8d","data":{"text":"她竟然反咬一口说是我甩了她，当年我明明找遍了所有地方，这九年到底是谁在撒谎？","version":1,"updatedAt":"2026-09-24T15:20:37.693Z","basedOnEventId":1790263237462,"basedOnSummaryCount":1},"updatedAt":1790825334947},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"stanceHistory","userId":"uid_1790255859673_etnh6cp03","itemId":"2ezb4yo6v07","data":{"text":"进了她家，我连她养的猫的醋都要吃。今晚我必须是老大，她只能抱我，得好好哄哄我这个巨婴。","version":10,"updatedAt":"2026-10-02T00:42:05.015Z","basedOnEventId":1790901724610,"basedOnSummaryCount":43},"updatedAt":1790903539638},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"stanceHistory","userId":"uid_1790255859673_etnh6cp03","itemId":"9k17i4nm80","data":{"text":"牵着她的手，我忍不住得寸进尺地想要离她更近。听她开玩笑说要退订，我只想告诉她这辈子我都跟她终身绑定了。今晚我要跟她回家，去见见那只叫毛毛的‘情敌’。","version":7,"updatedAt":"2026-10-01T17:32:19.740Z","basedOnEventId":1790875939292,"basedOnSummaryCount":38},"updatedAt":1790876329186},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"stanceHistory","userId":"uid_1790255859673_etnh6cp03","itemId":"9nzd764jzb","data":{"text":"听到她亲口承认心里也只有我，我那些伪装的戏谑终于彻底卸下了。牵着她的手，我真切地感受到她的温度，只想这样一直纵容、霸占着她，再也不放手。","version":5,"updatedAt":"2026-10-01T17:06:31.499Z","basedOnEventId":1790874390977,"basedOnSummaryCount":35},"updatedAt":1790874804115},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"stanceHistory","userId":"uid_1790255859673_etnh6cp03","itemId":"d8l9hnt4x3","data":{"text":"牵着她的手，我忍不住得寸进尺地想要离她更近。看着她，我半开玩笑半认真地想，如果她敢收，我真的不介意把自己整个人都赔给她。","version":6,"updatedAt":"2026-10-01T17:13:23.993Z","basedOnEventId":1790874803616,"basedOnSummaryCount":37},"updatedAt":1790875939893},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"stanceHistory","userId":"uid_1790255859673_etnh6cp03","itemId":"jbfjyary9f","data":{"text":"既然她把我当狗宠，那今晚就必须搂着我睡。我已经赖在她身上了，今晚绝对不放手，看她能拿我怎么办。","version":12,"updatedAt":"2026-10-02T01:27:02.792Z","basedOnEventId":1790904422354,"basedOnSummaryCount":45},"updatedAt":1790905186626},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"stanceHistory","userId":"uid_1790255859673_etnh6cp03","itemId":"of0m17oawb","data":{"text":"她主动抱我了，那反悔就绝对无效。今晚她只能是我的，连那只毛球也别想分走她的注意力。","version":11,"updatedAt":"2026-10-02T01:12:19.526Z","basedOnEventId":1790903539035,"basedOnSummaryCount":44},"updatedAt":1790904422935},{"tbl":"memory","rowKey":"uid_1790255859673_etnh6cp03|0c02fada-2752-4b73-9ed6-d11585398260","field":"stanceHistory","userId":"uid_1790255859673_etnh6cp03","itemId":"pb6r7az4ux","data":{"text":"原来这九年我们都在互相误解，她以为我甩了她，我以为她不要我了，这种错位让我感到荒谬又心痛。","version":2,"updatedAt":"2026-09-25T00:07:02.722Z","basedOnEventId":1790294822515,"basedOnSummaryCount":2},"updatedAt":1790825334947},{"tbl":"memory","rowKey":"uid_1790400508747_iwgggr5co|daf09068-8f59-4b3d-ab7c-245438c36c7e","field":"stanceHistory","userId":"uid_1790400508747_iwgggr5co","itemId":"17m4qw3pw4j","data":{"text":"[群聊不想学习中] 终于追到了她，这辈子都要赖定她","version":5,"updatedAt":"2026-09-26T08:10:40.139Z","basedOnEventId":1790410239942,"basedOnSummaryCount":12},"updatedAt":1790768851385},{"tbl":"memory","rowKey":"uid_1790400508747_iwgggr5co|daf09068-8f59-4b3d-ab7c-245438c36c7e","field":"stanceHistory","userId":"uid_1790400508747_iwgggr5co","itemId":"1alcd2blj4r","data":{"text":"终于追到了她，这辈子都要赖定她。看到她被弟弟气哭真的很心疼，她脾气太好了，以后有我护着她，谁也不能欺负她。","version":6,"updatedAt":"2026-09-27T07:44:46.883Z","basedOnEventId":1790495086065,"basedOnSummaryCount":12},"updatedAt":1790768851385},{"tbl":"memory","rowKey":"uid_1790400508747_iwgggr5co|daf09068-8f59-4b3d-ab7c-245438c36c7e","field":"stanceHistory","userId":"uid_1790400508747_iwgggr5co","itemId":"1ngyx009w6l","data":{"text":"她终于跨出了这一步，既然她答应了，那我就绝不会放手，异地和学业的困难我会陪她一起扛。她现在越来越依赖我了，这种被她完全信任的感觉，让我只想把全世界最好的都捧到她面前。","version":4,"updatedAt":"2026-09-26T07:31:01.870Z","basedOnEventId":1790407861609,"basedOnSummaryCount":5},"updatedAt":1790768851385},{"tbl":"memory","rowKey":"uid_1790400508747_iwgggr5co|daf09068-8f59-4b3d-ab7c-245438c36c7e","field":"stanceHistory","userId":"uid_1790400508747_iwgggr5co","itemId":"1rqsslcuull","data":{"text":"只要能逗她开心，当个被她迷傻的「傻狗」也无所谓。我越来越期待去校门口接她了，想快点见到我的女孩。","version":12,"updatedAt":"2026-09-27T15:30:42.992Z","basedOnEventId":1790523042292,"basedOnSummaryCount":21},"updatedAt":1790768852105},{"tbl":"memory","rowKey":"uid_1790400508747_iwgggr5co|daf09068-8f59-4b3d-ab7c-245438c36c7e","field":"stanceHistory","userId":"uid_1790400508747_iwgggr5co","itemId":"2ai6g47a0u7","data":{"text":"终于追到了她，这辈子都要赖定她。虽然她父母不开明只能谈“地下恋”，但我还挺享受当她的“男朋友”，连人带钱都想给她。可她明天就要开学且拿不到手机，要到9月30日才能再联系，真舍不得和她分开，今晚必须让她多陪陪我。","version":8,"updatedAt":"2026-09-27T15:08:48.299Z","basedOnEventId":1790521727920,"basedOnSummaryCount":16},"updatedAt":1790768851385},{"tbl":"memory","rowKey":"uid_1790400508747_iwgggr5co|daf09068-8f59-4b3d-ab7c-245438c36c7e","field":"stanceHistory","userId":"uid_1790400508747_iwgggr5co","itemId":"2l055fdb8f","data":{"text":"既然她这么拼，看来得找点更有趣的话题才能引起她的注意。现在这份心意终于传达出去了，希望能得到她的回应。","version":2,"updatedAt":"2026-09-26T06:51:59.654Z","basedOnEventId":1790405519350,"basedOnSummaryCount":2},"updatedAt":1790768851385},{"tbl":"memory","rowKey":"uid_1790400508747_iwgggr5co|daf09068-8f59-4b3d-ab7c-245438c36c7e","field":"stanceHistory","userId":"uid_1790400508747_iwgggr5co","itemId":"5qey9zosjq","data":{"text":"舍不得和她分开，更想在即将到来的国庆假期见到她。不管距离有多远、她妈妈管得多严，我都要想办法去见她，或者接她来找我，只要她一句话，我随时都可以出发。","version":9,"updatedAt":"2026-09-27T15:12:09.450Z","basedOnEventId":1790521929086,"basedOnSummaryCount":17},"updatedAt":1790768851385},{"tbl":"memory","rowKey":"uid_1790400508747_iwgggr5co|daf09068-8f59-4b3d-ab7c-245438c36c7e","field":"stanceHistory","userId":"uid_1790400508747_iwgggr5co","itemId":"95senh5ch2","data":{"text":"终于定好国庆去见她的计划了！她让我去学校找她，约定在9月30日下午六点见面。我已经迫不及待要去接她了，到时候一定要守在她学校附近，让她一出来就能看见我，绝不让她乱跑。","version":10,"updatedAt":"2026-09-27T15:18:33.239Z","basedOnEventId":1790522312864,"basedOnSummaryCount":18},"updatedAt":1790768851385},{"tbl":"memory","rowKey":"uid_1790400508747_iwgggr5co|daf09068-8f59-4b3d-ab7c-245438c36c7e","field":"stanceHistory","userId":"uid_1790400508747_iwgggr5co","itemId":"beiep3d6oz","data":{"text":"她不能带手机，我们约好在学校对面的大树下见面。我一定要在那一直守着她，甚至想让全校都知道她是我的。我已经等不及要在校门口接我的女孩了。","version":11,"updatedAt":"2026-09-27T15:23:03.716Z","basedOnEventId":1790522583258,"basedOnSummaryCount":20},"updatedAt":1790768851385},{"tbl":"memory","rowKey":"uid_1790400508747_iwgggr5co|daf09068-8f59-4b3d-ab7c-245438c36c7e","field":"stanceHistory","userId":"uid_1790400508747_iwgggr5co","itemId":"pn352914mf","data":{"text":"既然她这么拼，看来得找点更有趣的话题才能引起她的注意。","version":1,"updatedAt":"2026-09-26T05:49:59.153Z","basedOnEventId":1790401798945,"basedOnSummaryCount":1},"updatedAt":1790768851385},{"tbl":"memory","rowKey":"uid_1790400508747_iwgggr5co|daf09068-8f59-4b3d-ab7c-245438c36c7e","field":"stanceHistory","userId":"uid_1790400508747_iwgggr5co","itemId":"wmrigf3la","data":{"text":"终于追到了她，这辈子都要赖定她。虽然她父母不开明只能谈“地下恋”，但我还挺享受当她随叫随到的“姐夫”。她脾气太好，10块钱就被弟弟收买，以后有我护着她，谁也不能欺负她。","version":7,"updatedAt":"2026-09-27T07:54:13.026Z","basedOnEventId":1790495652750,"basedOnSummaryCount":14},"updatedAt":1790768851385},{"tbl":"memory","rowKey":"uid_1790400508747_iwgggr5co|daf09068-8f59-4b3d-ab7c-245438c36c7e","field":"stanceHistory","userId":"uid_1790400508747_iwgggr5co","itemId":"zmkag8k47f","data":{"text":"她终于跨出了这一步，既然她答应了，那我就绝不会放手，异地和学业的困难我会陪她一起扛。","version":3,"updatedAt":"2026-09-26T06:59:13.349Z","basedOnEventId":1790405953181,"basedOnSummaryCount":3},"updatedAt":1790768851385}]