57},{"id":1794613981970,"sender":"them","text":"搬个双人的粗藤摇椅过去","timestamp":1794616026041,"tempo":"N","rawContent":"搬个双人的粗藤摇椅过去","roundId":"round_1794615900455_ycnx37e2j","userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":11758},{"id":1794613981971,"sender":"them","text":"铺厚羊毛毯子","timestamp":1794616027720,"tempo":"R","rawContent":"铺厚羊毛毯子","roundId":"round_1794615900455_ycnx37e2j","userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":11759},{"id":1794613981972,"sender":"them","text":"两个人窝进去刚好能塞满的那种","timestamp":1794616039260,"tempo":"S","rawContent":"两个人窝进去刚好能塞满的那种","roundId":"round_1794615900455_ycnx37e2j","userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":11760},{"id":1794613981973,"sender":"them","text":"省得某人整天说地毯硬","timestamp":1794616044281,"tempo":"N","rawContent":"省得某人整天说地毯硬","roundId":"round_1794615900455_ycnx37e2j","userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":11761},{"id":1794613981974,"sender":"them","text":"归娇娇","timestamp":1794616045875,"tempo":"R","rawContent":"归娇娇","roundId":"round_1794615900455_ycnx37e2j","userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":11762},{"id":1794613981975,"sender":"them","text":"你觉得呢","timestamp":1794616052690,"tempo":"S","rawContent":"你觉得呢","roundId":"round_1794615900455_ycnx37e2j","userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":11763},{"id":1794613981976,"text":"<memo> {\"memoText\": \"大清早被她低头亲了一下，本来还泛着酸气的脖子和腰瞬间就软下来了。~^^^^两个人缩在新家这个大床里，外头雨声砸得窗玻璃噼啪响，她腰酸得不想动，却偏要眯着眼睛问我想给屋里添点什么。\\n\\n其实添什么都行。哪怕真就这么空着，只要每天醒过来能一把揽住她温热的腰，看她不声不响由着我把下巴搁在她肩头，这屋子在我这儿就不算空。~^^^但我还是巴不得把角角落落全塞满两个人的东西，黑胶架子、阳台摇椅、甚至连猫的窝都得挨在一块儿。\\n\\n想把这里彻彻底底变成我们一辈子的窝。\"} </memo>","rawContent":"<memo> {\"memoText\": \"大清早被她低头亲了一下，本来还泛着酸气的脖子和腰瞬间就软下来了。~^^^^两个人缩在新家这个大床里，外头雨声砸得窗玻璃噼啪响，她腰酸得不想动，却偏要眯着眼睛问我想给屋里添点什么。\\n\\n其实添什么都行。哪怕真就这么空着，只要每天醒过来能一把揽住她温热的腰，看她不声不响由着我把下巴搁在她肩头，这屋子在我这儿就不算空。~^^^但我还是巴不得把角角落落全塞满两个人的东西，黑胶架子、阳台摇椅、甚至连猫的窝都得挨在一块儿。\\n\\n想把这里彻彻底底变成我们一辈子的窝。\"} </memo>","isHtml":false,"sticker":null,"sender":"them","time":"08:27","timestamp":1794616079161,"roundId":"round_1794615900455_ycnx37e2j","generatedMode":false,"translation":null,"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":11764},{"id":1794613981978,"text":"好","sender":"me","time":"08:28","timestamp":1794616093473,"replyTo":{"id":1794613981964,"text":"我想在那儿打一整面实木黑胶架子","sender":"them","isSimulated":false},"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":11766},{"id":1794613981979,"text":"单人的不行吗","sender":"me","time":"08:28","timestamp":1794616107567,"replyTo":{"id":1794613981970,"text":"搬个双人的粗藤摇椅过去","sender":"them","isSimulated":false},"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":11767},{"id":1794613981980,"text":"我嫌你烦","sender":"me","time":"08:28","timestamp":1794616112680,"replyTo":null,"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":11768},{"id":1794613981990,"sender":"them","text":"听见那个干脆的「好」字，眼底闪过一点得逞的亮光，嘴角压不住地往上抬，整个人更沉地往她身上压了压。","timestamp":1794616167501,"tempo":"N","type":"state","rawContent":"听见那个干脆的「好」字，眼底闪过一点得逞的亮光，嘴角压不住地往上抬，整个人更沉地往她身上压了压。","roundId":"round_1794616114709_a4alj2n7s","userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":11777},{"id":1794613981991,"sender":"them","text":"架子算你通过了啊 归主任","timestamp":1794616173146,"tempo":"N","rawContent":"架子算你通过了啊 归主任","roundId":"round_1794616114709_a4alj2n7s","userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":11778},{"id":1794613981992,"sender":"them","text":"不许反悔","timestamp":1794616174619,"tempo":"R","rawContent":"不许反悔","roundId":"round_1794616114709_a4alj2n7s","use