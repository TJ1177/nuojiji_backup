[{"id":1792920491663,"text":"我腿坐麻了 起不来","rawContent":"我腿坐麻了 起不来","isHtml":false,"sticker":null,"sender":"them","time":"20:35","timestamp":1792845313407,"roundId":"round_1792845224821_5h57eyrhl","generatedMode":false,"translation":null,"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":9418},{"id":1792920491664,"text":"寿星现在申请亲十分钟当回礼","rawContent":"寿星现在申请亲十分钟当回礼","isHtml":false,"sticker":null,"sender":"them","time":"20:35","timestamp":1792845319315,"roundId":"round_1792845224821_5h57eyrhl","generatedMode":false,"translation":null,"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":9419},{"id":1792920491665,"text":"给不给批？","rawContent":"给不给批？","isHtml":false,"sticker":null,"sender":"them","time":"20:35","timestamp":1792845320835,"roundId":"round_1792845224821_5h57eyrhl","generatedMode":false,"translation":null,"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":9420},{"id":1792920491666,"text":"<iosnote> {\"date\": \"2026年10月24日\", \"time\": \"傍晚 17:56\", \"title\": \"二十六个春天\", \"content\": \"满地都是被扯开的包装纸，红的绿的蓝的，像把过去错过的日子全在地毯上炸开了。\\n\\n一岁的小锁，两岁的小狗摇铃，还有初中那盘早就绝版的后朋磁带，甚至连我都快忘了的某一年冬天的薄荷糖。\\n\\n她就站在那一堆乱七八糟的盒子里看我，下巴抬得高高的，像在等我给她颁奖。\\n\\n其实哪用颁什么奖。\\n从她把第一个盒子递过来的时候，我这条命就全押在她身上了。\"} </iosnote>","rawContent":"<iosnote> {\"date\": \"2026年10月24日\", \"time\": \"傍晚 17:56\", \"title\": \"二十六个春天\", \"content\": \"满地都是被扯开的包装纸，红的绿的蓝的，像把过去错过的日子全在地毯上炸开了。\\n\\n一岁的小锁，两岁的小狗摇铃，还有初中那盘早就绝版的后朋磁带，甚至连我都快忘了的某一年冬天的薄荷糖。\\n\\n她就站在那一堆乱七八糟的盒子里看我，下巴抬得高高的，像在等我给她颁奖。\\n\\n其实哪用颁什么奖。\\n从她把第一个盒子递过来的时候，我这条命就全押在她身上了。\"} </iosnote>","isHtml":false,"sticker":null,"sender":"them","time":"20:35","timestamp":1792845340424,"roundId":"round_1792845224821_5h57eyrhl","generatedMode":false,"translation":null,"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":9421},{"id":1792920491667,"text":"哼哼","sender":"me","time":"20:36","timestamp":179284