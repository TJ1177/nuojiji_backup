":10326},{"id":1793453805088,"text":"嘿嘿","rawContent":"嘿嘿","isHtml":false,"sticker":null,"sender":"them","time":"17:22","timestamp":1793438533402,"roundId":"round_1793438474299_9h9xe7nzf","generatedMode":false,"translation":null,"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":10327},{"id":1793453805089,"text":"谁让你自己惯的","rawContent":"谁让你自己惯的","isHtml":false,"sticker":null,"sender":"them","time":"17:22","timestamp":1793438537128,"roundId":"round_1793438474299_9h9xe7nzf","generatedMode":false,"translation":null,"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":10328},{"id":1793453805090,"text":"天天嫌弃我 也没见你真把我从沙发上踹下去啊","rawContent":"天天嫌弃我 也没见你真把我从沙发上踹下去啊","isHtml":false,"sticker":null,"sender":"them","time":"17:22","timestamp":1793438544427,"roundId":"round_1793438474299_9h9xe7nzf","generatedMode":false,"translation":null,"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":10329},{"id":1793453805091,"text":"","rawContent":"","isHtml":false,"sticker":"https://i.postimg.cc/7Zm758bH/mmexport1769557930886.png","stickerMeaning":"小狗得志","sender":"them","time":"17:22","timestamp":1793438545245,"roundId":"round_1793438474299_9h9xe7nzf","generatedMode":false,"translation":null,"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":10330},{"id":1793453805092,"text":"方亦楷下巴搁在她肩头，很轻地咬了一下她的衣领，整个人懒散散地卸下所有防备","rawContent":"方亦楷下巴搁在她肩头，很轻地咬了一下她的衣领，整个人懒散散地卸下所有防备","isHtml":false,"sticker":null,"sender":"them","time":"17:22","timestamp":1793438556329,"roundId":"round_1793438474299_9h9xe7nzf","generatedMode":false,"type":"state","translation":null,"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":10331},{"id":1793453805093,"text":"反正赖上了 烦就烦吧","rawContent":"反正赖上了 烦就烦吧","isHtml":false,"sticker":null,"sender":"them","time":"17:22","timestamp":1793438560645,"roundId":"round_1793438474299_9h9xe7nzf","generatedMode":false,"translation":null,"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":10332},{"id":1793453805094,"text":"归主任受累 伺候一下你家大烦人精","rawContent":"归主任受累 伺候一下你家大烦人精","isHtml":false,"sticker":null,"sender":"them","time":"17:22","timestamp":1793438563753,"roundId":"round_1793438474299_9h9xe7nzf","generatedMode":false,"translation":null,"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":10333},{"id":1793453805095,"text":"饿不饿 晚上想吃什么 我等会儿起来弄","rawContent":"饿不饿 晚上想吃什么 我等会儿起来弄","isHtml":false,"sticker":null,"sender":"them","time":"17:22","timestamp":1793438576988,"roundId":"round_1793438474299_9h9xe7nzf","generatedMode":false,"translation":null,"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":10334},{"id":1793453805096,"text":"<iosnote> {\"date\": \"2026年10月31日\", \"time\": \"傍晚 17:21\", \"title\": \"大烦人精\", \"content\": \"她说我好烦，但按在我背上的手根本没舍得用力推我。这种口是心非的小习惯我简直摸得透透的。被她骂一句烦，心里反而跟抹了蜜一样舒坦。搬家这一周累得够呛，但只要能这么毫无顾忌地压在她身上赖一会儿，骨头缝里的酸劲儿全散了。有她在身边，当个死皮赖脸的大烦人精也没什么不好。\"} </iosnote>","rawContent":"<iosnote> {\"date\": \"2026年10月31日\", \"time\": \"傍晚 17:21\", \"title\": \"大烦人精\", \"content\": \"她说我好烦，但按在我背上的手根本没舍得用力推我。这种口是心非的小习惯我简直摸得透透的。被她骂一句烦，心里反而跟抹了蜜一样舒坦。搬家这一周累得够呛，但只要能这么毫无顾忌地压在她身上赖一会儿，骨头缝里的酸劲儿全散了。有她在身边，当个死皮赖脸的大烦人精也没什么不好。\"} </iosnote>","isHtml":false,"sticker":null,"sender":"them","time":"17:23","timestamp":1793438594503,"roundId":"round_1793438474299_9h9xe7nzf","generatedMode":false,"translation":null,"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":10335},{"id":1793453805097,"text":"<memo> {\"memoText\": \"嘴上说着你好烦，手却还在我后背上轻轻搭着~^^^其实她一向这样，刀子嘴豆腐心，真要是嫌我烦早就一脚把我踹到地毯上去了。\\n\\n这周搬家累得骨头架子都要散了，两个人挤在这个刚有点模样的客厅里，屋里全是打包盒的气味~~~^^^^^^但我心里却踏实得不行。听她这么随口骂我一句，反而比听什么好听的话都更让我安心，就像小狗终于在屋檐底下找到了自己的窝，不管怎么被数落，都知道自己不会再被丢下了。\\n\\n那就继续烦着你吧，反正这辈子我都打算这么烦下去了。\"} </memo>","rawContent":"<memo> {\"memoText\": \"嘴上说着你好烦，手却还在我后背上轻轻搭着~^^^其实她一向这样，刀子嘴豆腐心，真要是嫌我烦早就一脚把我踹到地毯上去了。\\n\\n这周搬家累得骨头架子都要散了，两个人挤在这个刚有点模样的客厅里，屋里全是打包盒的气味~~~^^^^^^但我心里却踏实得不行。听她这么随口骂我一句，反而比听什么好听的话都更让我安心，就像小狗终于在屋檐底下找到了自己的窝，不管怎么被数落，都知道自己不会再被丢下了。\\n\\n那就继续烦着你吧，反正这辈子我都打算这么烦下去了。\"} </memo>","isHtml":false,"sticker":null,"sender":"them","time":"17:23","timestamp":1793438620500,"roundId":"round_1793438474299_9h9xe7nzf","generatedMode":false,"translation":null,"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":10336},{"id":1793453805098,"text":"随便","sender":"me","time":"17:25","timestamp":1793438702759,"replyTo":null,"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":10337},{"id":1793453805099,"text":"？","sender":"me","time":"17:25","timestamp":1793438716752,"replyTo":{"id":1793453805090,"text":"天天嫌弃我 也没见你真把我从沙发上踹下去啊","sender":"them","sticker":null,"isSimulated":false},"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":10338},{"id":1793453805100,"text":"那你现在滚下去","sender":"me","time":"17:25","timestamp":1793438723464,"replyTo":null,"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":10339},{"id":1793453805110,"text":"方亦楷非但没松手，反而把长腿一伸直接横跨在沙发边沿，整个人像块化不开的实心橡皮糖似的结结实实压在她身侧，手臂顺势勒紧了她的腰，脸颊直接往她颈侧蹭得直发痒。","rawContent":"方亦楷非但没松手，反而把长腿一伸直接横跨在沙发边沿，整个人像块化不开的实心橡皮糖似的结结实实压在她身侧，手臂顺势勒紧了她的腰，脸颊直接往她颈侧蹭得直发痒。","isHtml":false,"sticker":null,"sender":"them","time":"17:26","timestamp":1793438779166,"roundId":"round_1793438724341_tmhclrrwm","generatedMode":false,"type":"state","translation":null,"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":10348},{"id":1793453805111,"text":"我不","rawContent":"我不","isHtml":false,"sticker":null,"sender":"them","time":"17:26","timestamp":1793438779909,"roundId":"round_1793438724341_tmhclrrwm","generatedMode":false,"translation":null,"userId":"uid_1790255859673_et