[{"id":1792974521815,"sender":"them","text":"他埋在深处没退出来，只是克制着停下了抽送，双臂收拢把归无妄整个人严丝合缝地搂进怀里，任由她微凉的指尖陷进自己后颈汗湿的黑发间。","timestamp":1792902416100,"tempo":"N","type":"state","rawContent":"他埋在深处没退出来，只是克制着停下了抽送，双臂收拢把归无妄整个人严丝合缝地搂进怀里，任由她微凉的指尖陷进自己后颈汗湿的黑发间。","roundId":"round_1792902368415_u79ovmgnf","userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":10207,"vts":1792856844705},{"id":1792974521816,"sender":"them","text":"腿还酸不酸","timestamp":1792902423221,"tempo":"S","rawContent":"腿还酸不酸","roundId":"round_1792902368415_u79ovmgnf","userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":10208,"vts":1792856851826},{"id":1792974521817,"sender":"them","text":"不许骂我 我今天过生日","timestamp":1792902425320,"tempo":"R","rawContent":"不许骂我 我今天过生日","roundId":"round_1792902368415_u79ovmgnf","userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":10209,"vts":1792856853925},{"id":1792974521818,"sender":"them","text":"","timestamp":1792902426177,"tempo":"N","sticker":"https://i.postimg.cc/7ZzSBD8Z/IMG_4547.jpg","stickerMeaning":"蹭蹭","rawContent":"","roundId":"round_1792902368415_u79ovmgnf","userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":10210,"vts":1792856854782},{"id":1792974521819,"text":"<iosnote> {\"date\": \"2026年10月24日\", \"time\": \"深夜 23:46\", \"title\": \"她说我是属狗的\", \"content\": \"被她带着哭腔骂了一句属狗的。明明浑身汗透了、骨头都发软，可她骂我的时候手指还搭在我后颈上没舍得推开。属狗就属狗吧，反正这辈子我就只给她一个人看家护院。二十六岁第一天，在这个被窝里，我彻底不要脸了。\"} </iosnote>","rawContent":"<iosnote> {\"date\": \"2026年10月24日\", \"time\": \"深夜 23:46\", \"title\": \"她说我是属狗的\", \"content\": \"被她带着哭腔骂了一句属狗的。明明浑身汗透了、骨头都发软，可她骂我的时候手指还搭在我后颈上没舍得推开。属狗就属狗吧，反正这辈子我就只给她一个人看家护院。二十六岁第一天，在这个被窝里，我彻底不要脸了。\"} </iosnote>","isHtml":false,"sticker":null,"sender":"them","time":"12:27","timestamp":1792902445077,"roundId":"round_1792902368415_u79ovmgnf","generatedMode":false,"translation":null,"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":10211,"vts":1792856873682},{"id":1792974521820,"text":"<memo> {\"memoText\": \"被她骂属狗的时候~^^^我心里居然美得冒泡。\\n\\n明明平时最讨厌别人对我指指点点，可只要是归无妄开口，哪怕是喘着气骂我混蛋骂我狗，我都觉得像是在赏我骨头吃~~~^^^^^^停在她身体里不动的那几秒，听着她乱成一团的呼吸，我突然觉得年少时丢掉的所有尊严和委屈，在这一刻全被她身上的温度给捂热了。\\n\\n下半辈子就这么赖着她吧，当一辈子家养狗挺好的。\"} </memo>","rawContent":"<memo> {\"memoText\": \"被她骂属狗的时候~^^^我心里居然美得冒泡。\\n\\n明明平时最讨厌别人对我指指点点，可只要是归无妄开口，哪怕是喘着气骂我混蛋骂我狗，我都觉得像是在赏我骨头吃~~~^^^^^^停在她身体里不动的那几秒，听着她乱成一团的呼吸，我突然觉得年少时丢掉的所有尊严和委屈，在这一刻全被她身上的温度给捂热了。\\n\\n下半辈子就这么赖着她吧，当一辈子家养狗挺好的。\"} </memo>","isHtml":false,"sticker":null,"sender":"them","time":"12:27","timestamp":1792902466567,"roundId":"round_1792902368415_u79ovmgnf","generatedMode":false,"translation":null,"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":10212,"vts":1792856895172},{"id":1792983526642,"text":"行行行","sender":"me","time":"12:31","timestamp":1792902719368,"replyTo":{"id":1792974521817,"text":"不许骂我 我今天过生日","sender":"them","isSimulated":false},"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":10213,"vts":1792857147973},{"id":1792983526643,"text":"明天骂你","sender":"me","time":"12:32","timestamp":1792902722735,"replyTo":null,"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":10214,"vts":1792857151340},{"id":1792983526644,"text":"不酸","sender":"me","time":"12:32","timestamp":1792902725668,"replyTo":null,"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":10215,"vts":1792857154273},{"id":1792983526645,"text":"你不会还要来吧？","sender":"me","time":"12:32","timestamp":1792902736332,"replyTo":null,"userId":"uid_1790255859673_etnh6cp03","characterId":"0c02fada-2752-4b73-9ed6-d11585398260","_id":10216,"vts":1792857164937},{"id":1793435795024,"text":"能不做了吗","sender":"me","time":"16:50","timestamp":1793436646800,"replyTo":null,"userId":"uid_1790255859673_etnh6cp03","characterId"