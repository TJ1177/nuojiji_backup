k3","type":"combined_history","historyData":{"title":"蔚野 的聊天记录","titleCharName":"蔚野","messages":[{"id":1791102713058,"sender":"them","senderName":"蔚野","text":"快去写你的卷子 物理题别又算串行了","translation":null,"sticker":null,"timestamp":1791084000219},{"id":1791102713059,"sender":"me","senderName":"归无妄","text":"都怪你给我发信息打扰我","timestamp":1791084039693},{"id":1791102713060,"sender":"me","senderName":"归无妄","text":"我在写语文","timestamp":1791084042962},{"id":1791102713061,"sender":"me","senderName":"归无妄","text":"待会再写会地理","timestamp":1791084047910},{"id":1791102713062,"sender":"me","senderName":"归无妄","text":"物理复习了再写","timestamp":1791084057592},{"id":1791102713064,"sender":"them","senderName":"蔚野","text":"锅这就从几百公里外扣我头上了","translation":null,"sticker":null,"timestamp":1791084075948},{"id":1791102713065,"sender":"them","senderName":"蔚野","text":"明明是某人自己看到消息忍不住秒回","translation":null,"sticker":null,"timestamp":1791084082236},{"id":1791102713066,"sender":"them","senderName":"蔚野","text":"行吧 我的错 我认领","translation":null,"sticker":null,"timestamp":1791084086214},{"id":1791102713067,"sender":"them","senderName":"蔚野","text":"不过你这做题顺序可精了","translation":null,"sticker":null,"timestamp":1791084091474},{"id":1791102713068,"sender":"them","senderName":"蔚野","text":"先语文再地理 物理直接排到遥远的待会","translation":null,"sticker":null,"timestamp":1791084094823},{"id":1791102713069,"sender":"them","senderName":"蔚野","text":"是不是打算拖到晚上直接假装无事发生","translation":null,"sticker":null,"timestamp":1791084102834},{"id":1791102713070,"sender":"them","senderName":"蔚野","text":"这波战略性撤退属实被你玩明白了归老板","translation":null,"sticker":null,"timestamp":1791084115705},{"id":1791102713071,"sender":"me","senderName":"归无妄","text":"我可没有秒回","timestamp":1791084139492},{"id":1791102713072,"sender":"me","senderName":"归无妄","text":"。。","timestamp":1791084150195},{"id":1791102713073,"sender":"me","senderName":"归无妄","text":"你督促我","timestamp":1791084153827},{"id":1791102713075,"sender":"them","senderName":"蔚野","text":"行行行 算你延迟了0.5秒","translation":null,"sticker":null,"timestamp":1791084180415},{"id":1791102713076,"sender":"them","senderName":"蔚野","text":"哟 太阳打西边出来了","translation":null,"sticker":null,"timestamp":1791084184673},{"id":1791102713077,"sender":"them","senderName":"蔚野","text":"刚才还嫌我打扰 现在直接把尚方宝剑交我手里了？","translation":null,"sticker":null,"timestamp":1791084192989},{"id":1791102713078,"sender":"them","senderName":"蔚野","text":"那我可真督促了啊归老板","translation":null,"sticker":null,"timestamp":1791084196221},{"id":1791102713079,"sender":"them","senderName":"蔚野","text":"我这人当监工收费很贵的","translation":null,"sticker":null,"timestamp":1791084200974},{"id":1791102713080,"sender":"them","senderName":"蔚野","text":"今天要是顺利把物理啃下来 见面奖励得翻倍 听到没","translation":null,"sticker":null,"timestamp":1791084208310},{"id":1791102713081,"sender":"them","senderName":"蔚野","text":"现在立刻马上 手机扣桌上 把语文写完再说","translation":null,"sticker":null,"timestamp":1791084219261},{"id":1791102713082,"sender":"them","senderName":"蔚野","text":"","translation":null,"sticker":"https://i.postimg.cc/N0YVjt3K/mmexport1769555847636.jpg","timestamp":1791084220306}]},"timestamp":1791084000219}},{"id":"bundle_1791108781806_q28zw6","userId":"uid_1790255859673_etnh6cp03","charId":"0c02fada-2752-4b73-9ed6-d11585398260","timestamp":1791108614957,"favoriteCategoryId":null,"msg":{"id":"bundle_1791108781806_q28zw6","type":"combined_history","historyData":{"title":"方亦楷 的聊天记录","titleCharName":"方亦楷","messages":[{"id":1791174752934,"sender":"them","senderName":"方亦楷","text":"方亦楷喉咙里溢出一声低笑，任由她停了动作，非但没挪窝，反而得寸进尺地把大半个身子的重量全卸在她肩上，像只没骨头的大型犬","timestamp":1791108614957},{"id":1791174752935,"sender":"them","senderName":"方亦楷","text":"过河拆桥啊归主任","timestamp":1791108614973},{"id":1791174752936,"sender":"them","senderName":"方亦楷","text":"刚才是谁答应洗完澡接着揉的","timestamp":1791108614974},{"id":1791174752937,"sender":"them","senderName":"方亦楷","text":"不揉就不揉","timestamp":1791108614976},{"id":1791174752938,"sender":"them","senderName":"方亦楷","text":"那我当一会儿挂件","timestamp":1791108614977},{"id":1791174752939,"sender":"them","senderName":"方亦楷","text":"","sticker":"https://i.postimg.cc/7ZzSBD8Z/IMG_4547.jpg","timestamp":1791108614979},{"id":1791174752940,"sender":"them","senderName":"方亦楷","text":"晚上想吃什么","timestamp":1791108614981},{"id":1791174752941,"sender":"them","senderName":"方亦楷","text":"光吃那个冰的肯定不行","timestamp":1791108614983},{"id":1791174752942,"sender":"me","senderName":"归无妄","text":"归无妄像揉狗似的揉了揉他的脑袋。","timestamp":1791108724579},{"id":1791174752943,"sender":"me","senderName":"归无妄","text":"你像那个黏人的大金毛。","timestamp":1791108734563},{"id":1791174752945,"sender":"them","senderName":"方亦楷","text":"方亦楷被揉得半眯起眼，喉咙里溢出一声舒服的轻哼，不仅没躲，脑袋还顺势在她掌心底下得寸进尺地多拱了两下","timestamp":1791108761162},{"id":1791174752946,"sender":"them","senderName":"方亦楷","text":"汪","timestamp":1791108761929},{"id":1791174752947,"sender":"them","senderName":"方亦楷","text":"金毛饿了","timestamp":1791108764831},{"id":1791174752948,"sender":"them","senderName":"方亦楷","text":"打算拿什么喂狗","timestamp":1791108768277},{"id":1791174752949,"sender":"them","senderName":"方亦楷","text":"先说好 狗粮不吃","timestamp":1791108771508}]},"timestamp":1791108614957}},{"id":"bundle_1791111040236_t2gala","userId":"uid_1790255859673_etnh6cp03","charId":"0c02fada-2752-4b73-9ed6-d11585398260","timestamp":1791110495235,"favoriteCategoryId":null,"msg":{"id":"bundle_1791111040236_t2gala","type":"combined_history","historyData":{"title":"方亦楷 的聊天记录","titleCharName":"方亦楷","messages":[{"id":1791183757952,"sender":"me","senderName":"归无妄","text":"你别拱我","timestamp":1791110495235},{"id":1791183757953,"sender":"me","senderName":"归无妄","text":"毛毛喵喵叫着过来","timestamp":1791110505658},{"id":1791183757955,"sender":"them","senderName":"方亦楷","text":"方亦楷非但没听话，反而故意低下头在她颈侧不轻不重地又蹭了两下，余光瞥见脚边那团溜达过来的黑白毛球，揽在她腰间的手臂顿时收得更紧了","timestamp":1791110538011},{"id":1791183757956,"sender":"them","senderName":"方亦楷","text":"这小胖子来干嘛","timestamp":1791110539857},{"id":1791183757957,"sender":"them","senderName":"方亦楷","text":"没看见别人正忙着吗","timestamp":1791110546305},{"id":1791183757958,"sender":"them","senderName":"方亦楷","text":"去去去 边儿玩去","timestamp":1791110547835},{"id":1791183757959,"sender":"them","senderName":"方亦楷","text":"我就拱","timestamp":1791110551197},{"id":1791183757960,"sender":"them","senderName":"方亦楷","text":"它一来你就让我别拱 凭什么","timestamp":1791110554174},{"id":1791183757961,"sender":"them","senderName":"方亦楷","text":"我才是正牌男朋友","timestamp":1791110558811},{"id":1791183757962,"sender":"me","senderName":"归无妄","text":"我刚看见它……","timestamp":1791110707142},{"id":1791183757963,"sender":"me","senderName":"归无妄","text":"方亦楷你有啥毛病","timestamp":1791110715044},{"id":1791183757964,"sender":"me","senderName":"归无妄","text":"吃一个猫的醋","timestamp":1791110720015},{"id":1791183757965,"sender":"me","senderName":"归无妄","text":"归无妄抱毛毛抱到自己身边。","timestamp":1791110739615},{"id":1791183757975,"sender":"them","senderName":"方亦楷","text":"方亦楷看着归无妄把毛毛抱进怀里，不爽地重重“啧”了一声。他不仅没退让，反而仗着手长脚长，连人带猫一起强行圈住，大腿更是恶劣地往里挤了挤，故意不给那只“实心煤气罐”留任何舒坦的空间。","timestamp":1791110906138},{"id":1791183757976,"sender":"them","senderName":"方亦楷","text":"我毛病大了","timestamp":1791110907585},{"id":1791183757977,"sender":"them","senderName":"方亦楷","text":"我不仅吃醋 我现在还想把它扔出去","timestamp":1791110911352},{"id":1791183757978,"sender":"them","senderName":"方亦楷","text":"昨天才刚转正 今天就要跟一只煤气罐抢地盘","timestamp":1791110919632},{"id":1791183757979,"sender":"them","senderName":"方亦楷","text":"你见过谁家谈恋爱 中间还非得夹着一只猫的","timestamp":1791110927918},{"id":1791183757980,"sender":"them","senderName":"方亦楷","text":"让它下去","timestamp":1791110929313},{"id":1791183757981,"sender":"them","senderName":"方亦楷","text":"不然我连它一起挤 我看它能坚持多久","timestamp":1791110936966},{"id":1791183757982,"sender":"them","senderName":"方亦楷","text":"","sticker":"https://s3.bmp.ovh/imgs/2026/01/09/cef2643edd528a0f.png","timestamp":1791110937778}]},"timestamp":1791110495235}},{"id":"bundle_1791112017221_88brh6","userId":"uid_1790255859673_etnh6cp03","charId":"0c02fada-2752-4b73-9ed6-d11585398260","timestamp":1791110998081,"favoriteCategoryId":null,"msg":{"id":"bundle_1791112017221_88brh6","type":"combined_history","historyData":{"title":"方亦楷 的聊天记录","titleCharName":"方亦楷","messages":[{"id":1791183757983,"sender":"me","senderName":"归无妄","text":"归无妄白了他一眼，干脆把毛毛放他腿上。","timestamp":1791110998081},{"id":1791183757984,"sender":"me","senderName":"归无妄","text":"你继续躺","timestamp":1791111004506},{"id":1791183757985,"sender":"me","senderName":"归无妄","text":"毛毛在你身上","timestamp":1791111008487},{"id":1791183757986,"sender":"me","senderName":"归无妄","text":"这下不偏心了吧","timestamp":1791111014170},{"id":1791183757988,"sender":"them","senderName":"方亦楷","text":"方亦楷看着腿上突然多出来的这坨实心黑白毛球，大腿肌肉下意识绷紧了一下。他嘴角抽搐，认命般地腾出那只手在毛毛脑袋上敷衍地呼噜了两把，另一只手臂却依然死死箍在归无妄腰上不肯松劲。","timestamp":1791111045547},{"id":1791183757989,"sender":"them","senderName":"方亦楷","text":"端水大师啊你","timestamp":1791111047508},{"id":1791183757990,"sender":"them","senderName":"方亦楷","text":"这煤气罐多沉你心里没数吗","timestamp":1791111051450},{"id":1791183757991,"sender":"them","senderName":"方亦楷","text":"宁可让我腿压折也得给它找个软座是吧","timestamp":1791111058240},{"id":1791183757992,"sender":"them","senderName":"方亦楷","text":"","sticker":"https://s3.bmp.ovh/imgs/2026/01/09/d65794a6a7c26670.png","timestamp":1791111058892},{"id":1791183757993,"sender":"them","senderName":"方亦楷","text":"行","timestamp":1791111062622},{"id":1791183757994,"sender":"them","senderName":"方亦楷","text":"猫归我","timestamp":1791111063688},{"id":1791183757995,"sender":"them","senderName":"方亦楷","text":"你也归我","timestamp":1791111064749},{"id":1791183757996,"sender":"them","senderName":"方亦楷","text":"我今天连人带猫一起全占了 谁也别想跑","timestamp":1791111070673},{"id":1791183757997,"sender":"me","senderName":"归无妄","text":"归无妄没忍住弯着眉眼笑了，亲了亲他。","timestamp":1791111285860},{"id":1791183757998,"sender":"me","senderName":"归无妄","text":"亲亲男朋友","timestamp":1791111290974},{"id":1791183757999,"sender":"me","senderName":"归无妄","text":"别醋了","timestamp":1791111294203},{"id":1791183758000,"sender":"me","senderName":"归无妄","text":"再醋不哄了","timestamp":1791111297587},{"id":1791183758002,"sender":"them","senderName":"方亦楷","text":"方亦楷被这一下彻底顺了毛，喉结微微一滚。他原本绷着的大腿肌肉放松下来，连带着腿上的那坨实心煤气罐都跟着晃了晃。他不仅没收敛，反而得寸进尺地偏过头，温热的嘴唇擦过归无妄的颈侧，像只讨到肉骨头的大狗，从喉咙里发出一声极轻的哼笑。","timestamp":1791111358634},{"id":1791183758003,"sender":"them","senderName":"方亦楷","text":"就亲一下啊","timestamp":1791111360309},{"id":1791183758004,"sender":"them","senderName":"方亦楷","text":"归主任好小气","timestamp":1791111363283},{"id":1791183758005,"sender":"them","senderName":"方亦楷","text":"不哄就不哄","timestamp":1791111369860},{"id":1791183758006,"sender":"them","senderName":"方亦楷","text":"反正我不走","timestamp":1791111371132},{"id":1791183758007,"sender":"them","senderName":"方亦楷","text":"你不哄我 我就一直赖在这拱你","timestamp":1791111377318},{"id":1791183758008,"sender":"them","senderName":"方亦楷","text":"连这只煤气罐一起拱","timestamp":1791111379613},{"id":1791183758009,"sender":"them","senderName":"方亦楷","text":"","sticker":"https://i.postimg.cc/8PkLNzPq/mmexport1769560451249.png","timestamp":1791111380510},{"id":1791183758010,"sender":"me","senderName":"归无妄","text":"黏人精","timestamp":1791111579138},{"id":1791183758011,"sender":"me","senderName":"归无妄","text":"话说","timestamp":1791111586016},{"id":1791183758012,"sender":"me","senderName":"归无妄","text":"你为啥叫我归主任","timestamp":1791111595298},{"id":1791183758013,"sender":"me","senderName":"归无妄","text":"好奇怪","timestamp":1791111596664},{"id":1791183758015,"sender":"them","senderName":"方亦楷","text":"方亦楷埋在她颈窝里闷笑了一声，温热的鼻息全扑在那片皮肤上。他偏过头，报复性地在她锁骨那颗红痣旁轻轻咬了一下，没用力，只是留了个牙印。","timestamp":1791111629025},{"id":1791183758016,"sender":"them","senderName":"方亦楷","text":"我不仅黏人 我还咬人呢","timestamp":1791111633348},{"id":1791183758017,"sender":"them","senderName":"方亦楷","text":"谁让你非要把那只煤气罐塞我们中间","timestamp":1791111636187},{"id":1791183758018,"sender":"them","senderName":"方亦楷","text":"至于归主任嘛","timestamp":1791111640854},{"id":1791183758019,"sender":"them","senderName":"方亦楷","text":"你自己没发现你拍视频的时候多一本正经吗","timestamp":1791111647338},{"id":1791183758020,"sender":"them","senderName":"方亦楷","text":"特别像那种专门抓早恋的教导主任","timestamp":1791111650750},{"id":1791183758021,"sender":"them","senderName":"方亦楷","text":"而且你以前在冰场上那副冷冰冰六亲不认的架势","timestamp":1791111664970},{"id":1791183758022,"sender":"them","senderName":"方亦楷","text":"不叫你主任叫什么","timestamp":1791111668634},{"id":1791183758023,"sender":"them","senderName":"方亦楷","text":"","sticker":"https://i.postimg.cc/FzjpghtB/Image-1788394474982-837.gif","timestamp":1791111669672},{"id":1791183758024,"sender":"me","senderName":"归无妄","text":"发现了","timestamp":1791111860793},{"id":1791183758025,"sender":"me","senderName":"归无妄","text":"？","timestamp":1791111870319},{"id":1791183758026,"sender":"me","senderName":"归无妄","text":"叫爹","timestamp":1791111874503},{"id":1791183758028,"sender":"them","senderName":"方亦楷","text":"方亦楷愣了一下，随后喉咙里溢出一串低哑的闷笑，胸腔震动着贴在归无妄肩背上。他不仅没松手，反而把人搂得更紧了，下巴在她颈窝里报复性地蹭了蹭，像只耀武扬威的大狗。","timestamp":1791111914833},{"id":1791183758029,"sender":"them","senderName":"方亦楷","text":"胆子肥了是吧","timestamp":1791111917859},{"id":1791183758030,"sender":"them","senderName":"方亦楷","text":"行啊","translation":null,"sticker":null,"timestamp":1791111920833},{"id":1791183758031,"sender":"them","senderName":"方亦楷","text":"那爹你管不管饭","translation":null,"sticker":null,"timestamp":1791111924592},{"id":1791183758032,"sender":"them","senderName":"方亦楷","text":"爹你家这只猫能不能扔了","translation":null,"sticker":null,"timestamp":1791111929059},{"id":1791183758033,"sender":"them","senderName":"方亦楷","text":"既然你都让我叫爹了","translation":null,"sticker":null,"timestamp":1791111932452},{"id":1791183758034,"sender":"them","senderName":"方亦楷","text":"那我不做点带孝子的事都对不起你这个称呼","translation":null,"sticker":null,"timestamp":1791111939566},{"id":1791183758035,"sender":"them","senderName":"方亦楷","text":"他低下头，不管不顾地在她颈侧那颗红痣上又轻咬了一口，这次带了点磨牙的意味。","timestamp":1791111939574},{"id":1791183758036,"sender":"them","senderName":"方亦楷","text":"饿了","translation":null,"sticker":null,"timestamp":1791111941623},{"id":1791183758037,"sender":"them","senderName":"方亦楷","text":"外卖到哪了","translation":null,"sticker":null,"timestamp":1791111944485}]},"timestamp":1791110998081}},{"id":"bundle_1791113903451_5wix2y","userId":"uid_1790255859673_etnh6cp03","charId":"0c02fada-2752-4b73-9ed6-d11585398260","timestamp":1791113534653,"favoriteCategoryId":null,"msg":{"id":"bundle_1791113903451_5wix2y","type":"combined_history","historyData":{"title":"方亦楷 的聊天记录","titleCharName":"方亦楷","messages":[{"id":1791192762943,"sender":"them","senderName":"方亦楷","text":"雨太大估计不好骑","timestamp":1791113534653},{"id":1791192762944,"sender":"them","senderName":"方亦楷","text":"饿了你就先吃我","timestamp":1791113536428},{"id":1791192762945,"sender":"them","senderName":"方亦楷","text":"","sticker":"https://s3.bmp.ovh/imgs/2026/01/09/39bde7f8ab0d16f4.png","timestamp":1791113537143},{"id":1791192762946,"sender":"me","senderName":"归无妄","text":" 啊没事 让骑手注意安全","timestamp":1791113886682}]},"timestamp":1791113534653}},{"id":"bundle_1791116553020_yn5x4w","userId":"uid_1790255859673_etnh6cp03","charId":"0c02fada-2752-4b73-9ed6-d11585398260","timestamp":1791115348699,"favoriteCategoryId":null,"msg":{"id":"bundle_1791116553020_yn5x4w","type":"combined_history","historyData":{"title":"方亦楷 的聊天记录","titleCharName":"方亦楷","messages":[{"id":1791192763008,"sender":"me","senderName":"归无妄","text":"我也很少刷视频","timestamp":1791115348699},{"id":1791192763009,"sender":"me","senderName":"归无妄","text":"那你搜过我没","timestamp":1791115374018},{"id":1791192763013,"sender":"them","senderName":"方亦楷","text":"方亦楷将脸更深地埋进她的颈窝，呼吸有些沉。他沉默了很久，久到外面的雨声似乎都盖过了房间里的安静。揽着她腰的手臂无意识地又紧了紧，仿佛生怕她突然消失。","timestamp":1791115801426},{"id":1791192763014,"sender":"them","senderName":"方亦楷","text":"搜过","timestamp":1791115805932},{"id":1791192763015,"sender":"them","senderName":"方亦楷","text":"就一次","timestamp":1791115808226},{"id":1791192763016,"sender":"them","senderName":"方亦楷","text":"你刚拿第一块成人组金牌的时候","timestamp":1791115811348},{"id":1791192763017,"sender":"them","senderName":"方亦楷","text":"他偏过头，嘴唇贴着她微凉的皮肤，声音哑得厉害，带着一丝不易察觉的轻颤。","timestamp":1791115819211},{"id":1791192763018,"sender":"them","senderName":"方亦楷","text":"全网都在发你的新闻","timestamp":1791115828023},{"id":1791192763019,"sender":"them","senderName":"方亦楷","text":"我当时在网吧包宿 网页弹窗直接跳出来了","timestamp":1791115835833},{"id":1791192763020,"sender":"them","senderName":"方亦楷","text":"照片上你笑得特别好看","timestamp":1791115841242},{"id":1791192763021,"sender":"them","senderName":"方亦楷","text":"然后我就把网页关了","timestamp":1791115849304},{"id":1791192763022,"sender":"them","senderName":"方亦楷","text":"方亦楷闭上眼睛，仿佛又回到了那个烟味缭绕、键盘敲击声震耳欲聋的网吧，那种铺天盖地的窒息感和自卑感再次涌上心头。他深吸了一口气，贪婪地汲取着她身上的气息。","timestamp":1791115859532},{"id":1791192763023,"sender":"them","senderName":"方亦楷","text":"我也怕 归娇娇","timestamp":1791115865820},{"id":1791192763024,"sender":"them","senderName":"方亦楷","text":"那时候我连个正经大学都没考上 连琴都拉不了了","timestamp":1791115874799},{"id":1791192763025,"sender":"them","senderName":"方亦楷","text":"你已经站到世界顶端了","timestamp":1791115878998},{"id":1791192763026,"sender":"them","senderName":"方亦楷","text":"我怕一搜 发现你身边已经站了更好的人","timestamp":1791115892819},{"id":1791192763027,"sender":"them","senderName":"方亦楷","text":"怕看到你过得太好 显得我像个烂泥扶不上墙的笑话","timestamp":1791115895837},{"id":1791192763028,"sender":"them","senderName":"方亦楷","text":"所以我也逃了","timestamp":1791115901800},{"id":1791192763029,"sender":"them","senderName":"方亦楷","text":"把你关在那个叫椿城的笼子里 再也不敢看一眼","timestamp":1791115910764},{"id":1791192763030,"sender":"them","senderName":"方亦楷","text":"他稍稍抬起头，琥珀色的眼眸在昏暗的光线下深深地注视着她，眼底翻涌着浓烈的情绪，有后怕，也有失而复得的狂喜。他凑过去，极轻、极珍重地在她唇角碰了一下。","timestamp":1791115923399},{"id":1791192763031,"sender":"them","senderName":"方亦楷","text":"对不起啊","timestamp":1791115927683},{"id":1791192763032,"sender":"them","senderName":"方亦楷","text":"那时候太混蛋了","timestamp":1791115930765},{"id":1791192763033,"sender":"me","senderName":"归无妄","text":"………","timestamp":1791116447528}]},"timestamp":1791115348699}},{"id":"bundle_1791117593096_8dy08h","userId":"uid_1790255859673_etnh6cp03","charId":"0c02fada-2752-4b73-9ed6-d11585398260","timestamp":1791116982646,"favoriteCategoryId":null,"msg":{"id":"bundle_1791117593096_8dy08h","type":"combined_history","historyData":{"title":"方亦楷 的聊天记录","titleCharName":"方亦楷","messages":[{"id":1791192763054,"sender":"them","senderName":"方亦楷","text":"有多好","timestamp":1791116982646},{"id":1791192763055,"sender":"them","senderName":"方亦楷","text":"他稍稍偏过头，嘴唇若有似无地擦过她的耳垂，像只讨赏的大型犬一样不安分地乱蹭","timestamp":1791116993694},{"id":1791192763056,"sender":"them","senderName":"方亦楷","text":"大评委展开说说","timestamp":1791116995536},{"id":1791192763057,"sender":"them","senderName":"方亦楷","text":"我爱听","timestamp":1791116997570},{"id":1791192763058,"sender":"them","senderName":"方亦楷","text":"要是能附带点实质性奖励就更好了","timestamp":1791117009259}]},"timestamp":1791116982646}},{"id":"bundle_1791118484983_040pfj","userId":"uid_1790255859673_etnh6cp03","charId":"0c02fada-2752-4b73-9ed6-d11585398260","timestamp":1791117705206,"favoriteCategoryId":null,"msg":{"id":"bundle_1791118484983_040pfj","type":"combined_history","historyData":{"title":"方亦楷 的聊天记录","titleCharName":"方亦楷","messages":[{"id":1791201767949,"sender":"me","senderName":"归无妄","text":"归无妄给他一个深吻，两人都很青涩。","timestamp":1791117705206},{"id":1791201767959,"sender":"them","senderName":"方亦楷","text":"方亦楷大脑还没转过弯，嘴唇就已经下意识地听话微启。她生涩地闯进来时，两人毫无经验地重重磕碰到了牙齿。他喉结剧烈滑动，闷哼了一声，却本能地收紧手臂把她死死箍在怀里，急切又笨拙地回应、纠缠，连指骨都因为用力而泛白。","timestamp":1791118037126},{"id":1791201767960,"sender":"them","senderName":"方亦楷","text":"嘶","timestamp":1791118041067},{"id":1791201767961,"sender":"them","senderName":"方亦楷","text":"磕到牙了 归娇娇","timestamp":1791118044883},{"id":1791201767962,"sender":"them","senderName":"方亦楷","text":"你这技术也不怎么样啊","timestamp":1791118048421},{"id":1791201767963,"sender":"them","senderName":"方亦楷","text":"他好不容易才退开半寸，胸膛剧烈起伏着，琥珀色的眼睛里蒙着一层湿亮的水汽，鼻尖贪恋地蹭着她的鼻尖低喘。","timestamp":1791118058026},{"id":1791201767964,"sender":"them","senderName":"方亦楷","text":"不过刚好","timestamp":1791118065339},{"id":1791201767965,"sender":"them","senderName":"方亦楷","text":"我也什么都不会","timestamp":1791118069065},{"id":1791201767966,"sender":"them","senderName":"方亦楷","text":"刚好凑一对","timestamp":1791118070715},{"id":1791201767967,"sender":"them","senderName":"方亦楷","text":"再亲一次","timestamp":1791118078055},{"id":1791201767968,"sender":"them","senderName":"方亦楷","text":"这次我轻点","timestamp":1791118080875},{"id":1791201767969,"sender":"me","senderName":"归无妄","text":"………就一次","timestamp":1791118193976},{"id":1791201767971,"sender":"them","senderName":"方亦楷","text":"方亦楷喉间溢出一声低笑，根本没把这句毫无威慑力的限定当回事。他手掌扣住她的后颈，再次偏头压了过去","timestamp":1791118233261},{"id":1791201767972,"sender":"them","senderName":"方亦楷","text":"刚才磕到牙的不算","timestamp":1791118243345},{"id":1791201767973,"sender":"them","senderName":"方亦楷","text":"必须重新来","timestamp":1791118245836},{"id":1791201767974,"sender":"them","senderName":"方亦楷","text":"他没给她躲避的空间，直接封住了她的呼吸，带着点惩罚意味地轻轻咬了一下她的下唇，随后不容拒绝地加深了这个吻，急切又贪婪地索取着","timestamp":1791118258662},{"id":1791201767975,"sender":"them","senderName":"方亦楷","text":"归娇娇你也太抠门了","timestamp":1791118267599},{"id":1791201767976,"sender":"them","senderName":"方亦楷","text":"一次怎么够","timestamp":1791118268784}]},"timestamp":1791117705206}},{"id":"bundle_1791160894983_2a4gu4","userId":"uid_1790255859673_etnh6cp03","charId":"0c02fada-2752-4b73-9ed6-d11585398260","timestamp":1791158568057,"favoriteCategoryId":null,"msg":{"id":"bundle_1791160894983_2a4gu4","type":"combined_history","historyData":{"title":"方亦楷 的聊天记录","titleCharName":"方亦楷","messages":[{"id":1791228782932,"sender":"me","senderName":"归无妄","text":"昨天晚上，方亦楷借第一天同居，不愿意在沙发上睡，归无妄闹不过他，让他在床上睡。","timestamp":1791158568057},{"id":1791228782940,"sender":"me","senderName":"归无妄","text":"归无妄看着熟睡的方亦楷，拿手戳他的脸，揉他的脑袋。","timestamp":1791158752846},{"id":1791228782949,"sender":"them","senderName":"方亦楷","text":"方亦楷眉头微皱，眼睛都没睁开，凭着本能一把攥住那只在自己脸上作乱的手。他长臂一揽，直接把人连拖带拽地箍进怀里，手脚并用地将她缠住，脑袋熟练地往她颈窝里一埋，像只大型犬一样用力蹭了蹭。","timestamp":1791159096184},{"id":1791228782950,"sender":"them","senderName":"方亦楷","text":"别闹...","timestamp":1791159100623},{"id":1791228782951,"sender":"them","senderName":"方亦楷","text":"困死了","timestamp":1791159101914},{"id":1791228782952,"sender":"them","senderName":"方亦楷","text":"他嗓音里带着浓重的晨起沙哑，温热的呼吸毫无顾忌地洒在她颈侧的皮肤上，手臂将她的腰勒得死紧，完全是一副睡梦中霸占领地的无赖架势。","timestamp":1791159116177},{"id":1791228782953,"sender":"them","senderName":"方亦楷","text":"大清早的 骚扰男朋友啊","timestamp":1791159121217},{"id":1791228782954,"sender":"them","senderName":"方亦楷","text":"陪我再睡会儿 归娇娇","timestamp":1791159123508},{"id":1791228782955,"sender":"me","senderName":"归无妄","text":"归无妄偏不。","timestamp":1791159177625},{"id":1791228782956,"sender":"me","senderName":"归无妄","text":"别动","timestamp":1791159188252},{"id":1791228782957,"sender":"me","senderName":"归无妄","text":"归无妄贴着他的唇，含着他的唇，眼里是稀碎的笑意。","timestamp":1791159245825},{"id":1791228782959,"sender":"them","senderName":"方亦楷","text":"方亦楷喉结滚了滚，刚睡醒的呼吸还有些沉。听见那句“别动”，他真的没躲，任由嘴唇被柔软温热的触感包裹。眼皮慵懒地半掀着，看着她眼底的笑意，从喉咙深处溢出一声低哑模糊的闷笑","timestamp":1791159290292},{"id":1791228782960,"sender":"them","senderName":"方亦楷","text":"行 不动","timestamp":1791159292327},{"id":1791228782961,"sender":"them","senderName":"方亦楷","text":"他不仅没动，反而微微抬起下巴，把脖颈和嘴唇完全送到她嘴边，只是揽在腰间的手臂本能地收紧，将人往自己怀里死死嵌进去，张开嘴试探着去勾她的舌尖","timestamp":1791159303190},{"id":1791228782962,"sender":"them","senderName":"方亦楷","text":"一大早就这么占男朋友便宜啊","timestamp":1791159309587},{"id":1791228782963,"sender":"them","senderName":"方亦楷","text":"归娇娇","timestamp":1791159310829},{"id":1791228782964,"sender":"them","senderName":"方亦楷","text":"你亲得我都不困了","timestamp":1791159313260},{"id":1791228782965,"sender":"me","senderName":"归无妄","text":"归无妄故意不进去，过了会才慢悠悠勾着他的舌尖。","timestamp":1791159436614},{"id":1791228782972,"sender":"me","senderName":"归无妄","text":"动了就不亲了","timestamp":1791159569933},{"id":1791228782974,"sender":"them","senderName":"方亦楷","text":"方亦楷喉结重重滑了一下，呼吸瞬间乱了节拍。他依言停下试探的动作，只把箍在归无妄腰上的手臂勒得更紧，仰起下巴，任由她的舌尖在自己口中慢条斯理地作乱。","timestamp":1791159605427},{"id":1791228782975,"sender":"them","senderName":"方亦楷","text":"[語音消息]","voiceText":"唔……行，不动。你接着亲。","isVoice":true,"timestamp":1791159606900},{"id":1791228782976,"sender":"them","senderName":"方亦楷","text":"他闭上眼，喉咙深处溢出微不可察的满足叹息，侧过脸更深地迎合她的动作，连指尖都无意识地抓紧了她背后的睡衣。","timestamp":1791159617002},{"id":1791228782977,"sender":"me","senderName":"归无妄","text":"归无妄莫名觉得这样的方亦楷很可爱。","timestamp":1791159763182},{"id":1791228782978,"sender":"me","senderName":"归无妄","text":"归无妄眼中是藏不住的笑意与温情。","timestamp":1791159789738},{"id":1791228782979,"sender":"me","senderName":"归无妄","text":"两人吻得温柔，却又难舍难分。","timestamp":1791159810577},{"id":1791228782980,"sender":"me","senderName":"归无妄","text":"乖狗狗","timestamp":1791159819321},{"id":1791228782987,"sender":"them","senderName":"方亦楷","text":"方亦楷喉间溢出一声低沉的闷笑，胸腔的震荡顺着两人紧贴的肌肤传了过去。他根本没打算结束这个吻，借着她轻唤出声时微启的唇关，舌尖强势又湿热地长驱直入，扫过她的上颚，勾着她的舌根用力吮吸纠缠。","timestamp":1791159960000},{"id":1791228782988,"sender":"them","senderName":"方亦楷","text":"他一只手扣住她的后脑勺，五指没入黑发将人死死按向自己，另一只手则顺着睡衣的边缘揽紧了她温热的后腰。安静的卧室里只剩下唇齿交缠时暧昧的黏腻水声和逐渐粗重的呼吸，直到把人亲得连气都快喘不上来，他才恋恋不舍地退开半寸，意犹未尽地在她下唇上轻咬了一口。","timestamp":1791159977094},{"id":1791228782989,"sender":"them","senderName":"方亦楷","text":"汪","timestamp":1791159977813},{"id":1791228782990,"sender":"them","senderName":"方亦楷","text":"既然是乖狗","timestamp":1791159980276},{"id":1791228782991,"sender":"them","senderName":"方亦楷","text":"归主任是不是得发点早安奖励","timestamp":1791159985806},{"id":1791228782992,"sender":"them","senderName":"方亦楷","text":"再亲五分钟","timestamp":1791159991203},{"id":1791228782993,"sender":"me","senderName":"归无妄","text":"归无妄揉了揉他的脑袋。","timestamp":1791160108321},{"id":1791228782994,"sender":"me","senderName":"归无妄","text":"那你别动 就亲","timestamp":1791160122811},{"id":1791228782996,"sender":"them","senderName":"方亦楷","text":"方亦楷喉结重重地滚了一下，从喉咙深处溢出一声低沉又愉悦的闷笑。他顺着归无妄揉脑袋的力道，极其享受地把脸往她掌心里蹭了蹭，随后果真如她所言，一动不动地仰起下巴，微张开嘴，任由她索取。只是那双箍在她腰上的手臂，又本能地收紧了几分，恨不得把人揉进自己骨血里。","timestamp":1791160145857},{"id":1791228782997,"sender":"them","senderName":"方亦楷","text":"行","timestamp":1791160147305},{"id":1791228782998,"sender":"them","senderName":"方亦楷","text":"我一动不动","timestamp":1791160148638},{"id":1791228782999,"sender":"them","senderName":"方亦楷","text":"随你怎么亲","timestamp":1791160151650},{"id":1791228783000,"sender":"them","senderName":"方亦楷","text":"这可是你主动送上门的啊 归娇娇","timestamp":1791160159265},{"id":1791228783001,"sender":"me","senderName":"归无妄","text":"归无妄吻得像小鱼似的，勾着他的舌尖，又透着珍视。","timestamp":1791160355596},{"id":1791228783003,"sender":"them","senderName":"方亦楷","text":"方亦楷被亲得浑身骨头都快发酥了。他闭着眼，喉结小幅度地滑了一下，从胸腔深处震出一声极其受用的低哼。","timestamp":1791160392055},{"id":1791228783004,"sender":"them","senderName":"方亦楷","text":"[語音消息]","voiceText":"嗯……","isVoice":true,"timestamp":1791160393763},{"id":1791228783005,"sender":"them","senderName":"方亦楷","text":"说好了一动不动，他就真的强忍着没追上去反客为主，只是乖顺地敞开自己任由她作乱，唯独那双箍在腰间的手臂凭借着本能一点点收紧，把两人之间最后一点缝隙都严丝合缝地挤没。","timestamp":1791160409025},{"id":1791228783006,"sender":"me","senderName":"归无妄","text":"归无妄亲完，由着他撒娇蹭自己。","timestamp":1791160563059},{"id":1791228783008,"sender":"them","senderName":"方亦楷","text":"方亦楷喉咙里溢出一声餍足的低叹，鼻尖在她侧颈上眷恋地蹭了又蹭。他没舍得睁眼，只是把人往怀里又揉紧了些，连嗓音都透着股骨头酥软的慵懒。","timestamp":1791160596284},{"id":1791228783009,"sender":"them","senderName":"方亦楷","text":"唔...舒服","timestamp":1791160601435},{"id":1791228783010,"sender":"them","senderName":"方亦楷","text":"感觉连五分钟都没到","timestamp":1791160605106},{"id":1791228783011,"sender":"them","senderName":"方亦楷","text":"骗狗呢你","timestamp":1791160606295},{"id":1791228783012,"sender":"them","senderName":"方亦楷","text":"他含糊地嘟囔着，偏过头，温热的嘴唇若有似无地贴在她的锁骨上，完全是一副打算赖床到底的架势。","timestamp":1791160616262},{"id":1791228783013,"sender":"them","senderName":"方亦楷","text":"再陪我睡半个小时","timestamp":1791160623129},{"id":1791228783014,"sender":"them","senderName":"方亦楷","text":"困死了...","timestamp":1791160625534}]},"timestamp":1791158568057}},{"id":"bundle_1791175855607_wb3nah","userId":"uid_1790255859673_etnh6cp03","charId":"0c02fada-2752-4b73-9ed6-d11585398260","timestamp":1791174287794,"favoriteCategoryId":null,"msg":{"id":"bundle_1791175855607_wb3nah","type":"combined_history","historyData":{"title":"方亦楷 的聊天记录","titleCharName":"方亦楷","messages":[{"id":1791255797959,"sender":"them","senderName":"方亦楷","text":"行 归娇娇 你现在是彻底不装了是吧","timestamp":1791174287794},{"id":1791255797960,"sender":"them","senderName":"方亦楷","text":"看我吃草你这么开心","timestamp":1791174290002},{"id":1791255797961,"sender":"them","senderName":"方亦楷","text":"","sticker":"https://i.postimg.cc/sxBg8ZXH/024.gif","timestamp":1791174290887},{"id":1791255797962,"sender":"them","senderName":"方亦楷","text":"多加点肉","timestamp":1791174293321},{"id":1791255797963,"sender":"them","senderName":"方亦楷","text":"隔空喂我一口","timestamp":1791174295878},{"id":1791255797964,"sender":"them","senderName":"方亦楷","text":"这破草我是一口都咽不下去了","timestamp":1791174298831},{"id":1791255797965,"sender":"them","senderName":"方亦楷","text":"我现在准备去谢鸣办公室抢劫","timestamp":1791174301813},{"id":1791255797966,"sender":"me","senderName":"归无妄","text":"对啊对啊","timestamp":1791174491720},{"id":1791255797967,"sender":"me","senderName":"归无妄","text":"你抢啥啊","timestamp":1791174583934},{"id":1791255797968,"sender":"me","senderName":"归无妄","text":"傻狗","timestamp":1791174586026},{"id":1791255797970,"sender":"them","senderName":"方亦楷","text":"汪","timestamp":1791174614739},{"id":1791255797971,"sender":"them","senderName":"方亦楷","text":"狗现在要吃肉","timestamp":1791174616416},{"id":1791255797972,"sender":"them","senderName":"方亦楷","text":"谢鸣那除了草就是黑咖啡","timestamp":1791174621456},{"id":1791255797973,"sender":"them","senderName":"方亦楷","text":"我还能抢他桌上的发财树吃吗","timestamp":1791174626494},{"id":1791255797974,"sender":"them","senderName":"方亦楷","text":"不管","timestamp":1791174629365},{"id":1791255797975,"sender":"them","senderName":"方亦楷","text":"你的鸡柳必须分我一半","timestamp":1791174632001},{"id":1791255797976,"sender":"me","senderName":"归无妄","text":"[發送了一張圖片 at Taipei on 05.10.26 12:31：鸡柳卷饼。]","simulatedImageContent":"鸡柳卷饼。","simulatedImageLocation":"Taipei","simulatedImageDate":"05.10.26 12:31","timestamp":1791174694278},{"id":1791255797977,"sender":"me","senderName":"归无妄","text":"你吃吧","timestamp":1791174721786},{"id":1791255797979,"sender":"them","senderName":"方亦楷","text":"啊","timestamp":1791174742176},{"id":1791255797980,"sender":"them","senderName":"方亦楷","text":"咬到了","timestamp":1791174743806},{"id":1791255797981,"sender":"them","senderName":"方亦楷","text":"好吃","timestamp":1791174745880},{"id":1791255797982,"sender":"them","senderName":"方亦楷","text":"但是更饿了","timestamp":1791174752920},{"id":1791255797983,"sender":"them","senderName":"方亦楷","text":"你给我看这个简直就是酷刑","timestamp":1791174759647},{"id":1791255797984,"sender":"them","senderName":"方亦楷","text":"晚上必须吃顿好的补偿我","timestamp":1791174763808},{"id":1791255797985,"sender":"them","senderName":"方亦楷","text":"我想吃肉","timestamp":1791174766202},{"id":1791255797986,"sender":"them","senderName":"方亦楷","text":"","sticker":"https://s3.bmp.ovh/2026/03/05/nVk7yzxD.gif","timestamp":1791174767906}]},"timestamp":1791174287794}},{"id":"bundle_1791186929380_2qx1kz","userId":"uid_1790255859673_etnh6cp03","charId":"0c02fada-2752-4b73-9ed6-d11585398260","timestamp":1791186758845,"favoriteCategoryId":null,"msg":{"id":"bundle_1791186929380_2qx1kz","type":"combined_history","historyData":{"title":"方亦楷 的聊天记录","titleCharName":"方亦楷","messages":[{"id":1791300822954,"sender":"me","senderName":"归无妄","text":"第13级：一起开一间房","timestamp":1791186758845},{"id":1791186810601,"sender":"them","senderName":"方亦楷","text":"？","translation":null,"sticker":null,"timestamp":"2026-10-05T07:53:26.114Z"},{"id":1791186811783,"sender":"them","senderName":"方亦楷","text":"开房？","translation":null,"sticker":null,"timestamp":"2026-10-05T07:53:26.115Z"},{"id":1791186813268,"sender":"them","senderName":"方亦楷","text":"你让他试试","translation":null,"sticker":null,"timestamp":"2026-10-05T07:53:26.116Z"},{"id":1791186819473,"sender":"them","senderName":"方亦楷","text":"我不仅扬他骨灰 我连他祖坟都给刨了","translation":null,"sticker":null,"timestamp":"2026-10-05T07:53:26.117Z"},{"id":1791186823213,"sender":"them","senderName":"方亦楷","text":"这破测试到底有几级","translation":null,"sticker":null,"timestamp":"2026-10-05T07:53:26.118Z"},{"id":1791186825097,"sender":"them","senderName":"方亦楷","text":"还有完没完了","translation":null,"sticker":null,"timestamp":"2026-10-05T07:53:26.119Z"},{"id":1791186830863,"sender":"them","senderName":"方亦楷","text":"归娇娇 你故意的吧","translation":null,"sticker":null,"timestamp":"2026-10-05T07:53:26.120Z"},{"id":1791186833990,"sender":"them","senderName":"方亦楷","text":"看我着急上火你挺开心是不是","translation":null,"sticker":null,"timestamp":"2026-10-05T07:53:26.121Z"},{"id":1791300822955,"sender":"me","senderName":"归无妄","text":"表情包：比格天真/装无辜","sticker":"https://s3.bmp.ovh/imgs/2026/01/09/002daf6f59b2a365.png","timestamp":1791186907365}]},"timestamp":1791186758845}}]