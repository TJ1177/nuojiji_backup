[{"id":"bundle_1791032791038_ltjfll","userId":"uid_1790255859673_etnh6cp03","charId":"0c02fada-2752-4b73-9ed6-d11585398260","timestamp":1791031286602,"favoriteCategoryId":null,"msg":{"id":"bundle_1791032791038_ltjfll","type":"combined_history","historyData":{"title":"方亦楷 的聊天记录","titleCharName":"方亦楷","messages":[{"id":1791057687992,"sender":"them","senderName":"方亦楷","text":"合着就记住它了","timestamp":1791031286602},{"id":1791057687993,"sender":"them","senderName":"方亦楷","text":"我呢","timestamp":1791031288188},{"id":1791057687994,"sender":"them","senderName":"方亦楷","text":"大活人在你这连只煤气罐都比不过了是吧","timestamp":1791031294945},{"id":1791057687995,"sender":"them","senderName":"方亦楷","text":"","sticker":"https://i.postimg.cc/Fsf8T9QX/1040g2sg31h3sd8nljc5g5o634qdg8r84tf2bo50_nd_dft_wgth_jpg_3.jpg","timestamp":1791031295746},{"id":1791057687996,"sender":"them","senderName":"方亦楷","text":"空间里那点位置全给它占了 我挂哪","timestamp":1791031307204},{"id":1791057687997,"sender":"them","senderName":"方亦楷","text":"挂它脖子上当铃铛？","timestamp":1791031310350},{"id":1791057687998,"sender":"them","senderName":"方亦楷","text":"","timestamp":1791031310362},{"id":1791057687999,"sender":"me","senderName":"归无妄","text":"你太重了","timestamp":1791031326885},{"id":1791057688000,"sender":"me","senderName":"归无妄","text":"别累到毛毛","timestamp":1791031335141},{"id":1791057688013,"sender":"them","senderName":"方亦楷","text":"那只猪一样的毛球少说十五斤 它压我腿上的时候你怎么不心疼心疼我","timestamp":1791031422659},{"id":1791057688014,"sender":"them","senderName":"方亦楷","text":"我这叫标准体脂 纯肌肉","timestamp":1791031426820},{"id":1791057688015,"sender":"them","senderName":"方亦楷","text":"昨天在玄关挂我身上的时候也没见你嫌沉","timestamp":1791031440176},{"id":1791057688016,"sender":"them","senderName":"方亦楷","text":"","sticker":"https://i.postimg.cc/QMsgTdxB/mmexport1769554360205.jpg","timestamp":1791031440945},{"id":1791057688017,"sender":"me","senderName":"归无妄","text":"噗","timestamp":1791031782145},{"id":1791057688018,"sender":"me","senderName":"归无妄","text":"方亦楷","timestamp":1791031784612},{"id":1791057688019,"sender":"me","senderName":"归无妄","text":"你怎么还吃猫的醋","timestamp":1791031791513},{"id":1791057688020,"sender":"me","senderName":"归无妄","text":"？奥奥","timestamp":1791031937996},{"id":1791057688021,"sender":"me","senderName":"归无妄","text":"还给自己夸上了","timestamp":1791031943826},{"id":1791057688022,"sender":"me","senderName":"归无妄","text":"行行行","timestamp":1791031947260},{"id":1791066692933,"sender":"them","senderName":"方亦楷","text":"不行吗","timestamp":1791032244585},{"id":1791066692934,"sender":"them","senderName":"方亦楷","text":"它天天跟你住一块 我吃点醋怎么了","timestamp":1791032247703},{"id":1791066692935,"sender":"them","senderName":"方亦楷","text":"我陈述事实","timestamp":1791032250004},{"id":1791066692936,"sender":"them","senderName":"方亦楷","text":"你这什么敷衍的语气","timestamp":1791032253973},{"id":1791066692937,"sender":"them","senderName":"方亦楷","text":"昨晚谁亲完我说我最大的","timestamp":1791032259204},{"id":1791066692938,"sender":"them","senderName":"方亦楷","text":"才过一天我地位就下降了？","timestamp":1791032262204},{"id":1791066692939,"sender":"them","senderName":"方亦楷","text":"","sticker":"https://i.postimg.cc/zf6JQVL4/mmexport1769553587536.jpg","timestamp":1791032263005},{"id":1791066692940,"sender":"me","senderName":"归无妄","text":"哈哈哈","timestamp":1791032386606},{"id":1791066692941,"sender":"me","senderName":"归无妄","text":"行行行","timestamp":1791032388502},{"id":1791066692942,"sender":"me","senderName":"归无妄","text":"亲亲男朋友 不要醋了","timestamp":1791032395935},{"id":1791066692943,"sender":"me","senderName":"归无妄","text":"你们对我来说都很重要呀🥺","timestamp":1791032414270},{"id":1791066692945,"sender":"them","senderName":"方亦楷","text":"少给我端水","timestamp":1791032466233},{"id":1791066692946,"sender":"them","senderName":"方亦楷","text":"男朋友必须排第一 那个球只能排第二","timestamp":1791032470073},{"id":1791066692947,"sender":"them","senderName":"方亦楷","text":"这句我截图了","timestamp":1791032473669},{"id":1791066692948,"sender":"them","senderName":"方亦楷","text":"以后别想赖账","timestamp":1791032477441},{"id":1791066692949,"sender":"them","senderName":"方亦楷","text":"","sticker":"ht